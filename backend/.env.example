# Copy to .env and fill with real values. NEVER commit the real .env.
# Server-side values are used only by the ops scripts in /backend/scripts
# (seed/verify against the real cloud) — the production backend itself is
# supabase/functions/data-api/index.ts, deployed straight from the Supabase
# dashboard and configured with its own Function Secrets, not this file.

# ---------- Supabase ----------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXXXXXXXXXXXXXXXXXXXXXXX   # client-safe (RLS protects data)
SUPABASE_SECRET_KEY=sb_secret_XXXXXXXXXXXXXXXXXXXXXXXX             # server-side ONLY
SUPABASE_DB_HOST=db.YOUR-PROJECT.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=YOUR_DB_PASSWORD                              # percent-encode special chars in URIs

# ---------- MongoDB Atlas ----------
MONGODB_USERNAME=YOUR_DB_USER
MONGODB_PASSWORD=YOUR_DB_PASSWORD
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?appName=APPNAME
MONGODB_DB=mfsl

# ---------- CEO identity (hardcoded by owner directive, 2026-08-30) ----------
# The CEO account is NEVER registered — it is locked to this email + UID.
MTEK_CEO_UID=d9c7fd50-0a60-4a16-b4ab-041cb568a49b
MTEK_CEO_PASSWORD=replace-with-real-ceo-password   # preview parity + deploy checks only
MTEK_CEO_SIG=replace-with-real-signature-passcode  # seeded as bcrypt hash by deploy script
